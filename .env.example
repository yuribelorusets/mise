# LLM: "anthropic" (default when ANTHROPIC_API_KEY is set) or "mock" (offline, deterministic)
ANTHROPIC_API_KEY=
MISE_LLM=
MISE_MODEL=claude-sonnet-5-5

# Freeze "today" for reproducible evals (YYYY-MM-DD). Leave empty in production.
MISE_TODAY=

# CRM webhook: any endpoint (Zapier, Make, HubSpot workflow, n8n, webhook.site)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=change-me

# Twilio voice
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=https://your-app.onrender.com
MANAGER_PHONE=+15105550100

PORT=3000

# Which business to run: a file in data/restaurants/ (fennel-ash = demo restaurant, ruki = pop-up preorders)
MISE_RESTAURANT=fennel-ash

# Where orders and conversation logs are saved (JSONL). Empty = memory only, lost on restart.
DATA_DIR=./data/runtime

# Owner dashboard at /admin. Disabled when empty. Use a long random string.
ADMIN_TOKEN=

# Guardrails for a public link
MISE_RATE_PER_MIN=10        # messages per visitor per minute
MISE_MAX_TURNS=30           # messages per conversation
MISE_DAILY_BUDGET_USD=2     # model spend per day; after that the agent points guests to Instagram/phone
