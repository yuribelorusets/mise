#!/bin/sh
# Reject AI attribution trailers. Claude is credited once, in the README.
# Enable with: git config core.hooksPath .githooks
if grep -qiE '^(Co-Authored-By: .*(Claude|anthropic)|Claude-Session:)' "$1"; then
  echo "commit-msg: remove the Co-Authored-By/Claude-Session line (credit lives in the README)" >&2
  exit 1
fi
