{
  "name": "mise",
  "version": "0.1.0",
  "description": "Multilingual AI front-of-house agent for restaurants: chat + phone, CRM webhooks, and a built-in eval suite.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "chat": "tsx src/channels/cli.ts",
    "eval": "tsx src/evals/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "author": "Yuri Belorusets",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
